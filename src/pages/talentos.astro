---
import CoverActions from '../components/CoverActions.astro'
import PageCover from '../components/PageCover.astro'
import { sectionAt } from '../components/sections'
import TalentItem from '../components/TalentItem.astro'
import { repositoryLede, talents as allTalents } from '../content'
import { MAIN_ID, TEXT } from '../content/site'
import { breadcrumbs, collection } from '../content/structured-data'
import { anchor, REPOSITORY } from '../content/talents'
import BaseLayout from '../layouts/BaseLayout.astro'

const talents = await allTalents()
const labels = TEXT.talents
const lede = await repositoryLede(REPOSITORY, labels.lede)
const origin = Astro.site ?? Astro.url.origin
const description = `${lede} ${labels.count(talents.length)}.`
const page = { path: '/talentos/', name: labels.headline, description }
---

<BaseLayout
  title={labels.headline}
  description={description}
  path={page.path}
  structuredData={{
    '@graph': [
      breadcrumbs(origin, [{ name: labels.title, path: page.path }]),
      ...(talents.length > 0
        ? [
            collection(
              origin,
              page,
              talents.map((talent) => ({
                name: talent.data.name,
                url: new URL(`${page.path}#${anchor(talent.data.number)}`, origin).href,
              })),
            ),
          ]
        : []),
    ],
  }}
>
  <main id={MAIN_ID}>
    <PageCover title={labels.title} lede={lede} icon={sectionAt('/talentos/').icon}>
      <ul class="bb-facts">
        <li>{labels.count(talents.length)}</li>
      </ul>
      <CoverActions label={labels.post} href={labels.postUrl} repository={REPOSITORY} />
    </PageCover>
    <div class="bb-wrap bb-main">
      {
        talents.length > 0 ? (
          <section class="bb-listing" aria-labelledby="lista-title">
            <h2 id="lista-title" class="bb-eyebrow">
              {labels.listed}
            </h2>
            <ul class="bb-cards">
              {talents.map((talent) => (
                <TalentItem talent={talent} />
              ))}
            </ul>
          </section>
        ) : (
          <p class="bb-empty">{labels.empty}</p>
        )
      }
    </div>
  </main>
</BaseLayout>
