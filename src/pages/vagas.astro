---
import CoverActions from '../components/CoverActions.astro'
import Icon from '../components/Icon.astro'
import JobItem from '../components/JobItem.astro'
import PageCover from '../components/PageCover.astro'
import { sectionAt } from '../components/sections'
import { jobs as allJobs, openJobs, repositoryLede } from '../content'
import { repositoryUrl } from '../content/catalog'
import { REPOSITORY } from '../content/jobs'
import { MAIN_ID, TEXT } from '../content/site'
import { breadcrumbs, collection } from '../content/structured-data'
import BaseLayout from '../layouts/BaseLayout.astro'

const LISTED = 50

const [jobs, open] = await Promise.all([allJobs(), openJobs()])
const listed = jobs.slice(0, LISTED)
const labels = TEXT.jobs
const lede = await repositoryLede(REPOSITORY, labels.lede)
const origin = Astro.site ?? Astro.url.origin
const issues = `${repositoryUrl(REPOSITORY)}/issues`
const description = `${lede} ${labels.count(open.length)}.`
---

<BaseLayout
  title={labels.headline}
  description={description}
  path="/vagas/"
  structuredData={{
    '@graph': [
      breadcrumbs(origin, [{ name: labels.title, path: '/vagas/' }]),
      collection(
        origin,
        { path: '/vagas/', name: labels.headline, description },
        open.slice(0, LISTED).map((job) => ({ name: job.data.title, url: job.data.url })),
      ),
    ],
  }}
>
  <main id={MAIN_ID}>
    <PageCover title={labels.title} lede={lede} icon={sectionAt('/vagas/').icon}>
      <ul class="bb-facts">
        <li>{labels.count(open.length)}</li>
      </ul>
      <CoverActions label={labels.post} href={labels.postUrl} repository={REPOSITORY} />
    </PageCover>
    <div class="bb-wrap bb-main">
      {open.length === 0 && <p class="bb-empty">{labels.empty}</p>}
      {
        jobs.length > 0 && (
          <section class="bb-listing" aria-labelledby="lista-title">
            <h2 id="lista-title" class="bb-eyebrow">
              {open.length > 0 ? labels.listed(listed.length, jobs.length) : labels.closedListed}
            </h2>
            <ul class="bb-cards">
              {listed.map((job) => (
                <JobItem job={job} />
              ))}
            </ul>
          </section>
        )
      }
      {
        jobs.length > LISTED && (
          <a href={issues} target="_blank" rel="noopener noreferrer" class="bb-button bb-button--ghost bb-section__more">
            {labels.all}
            <Icon name="external" size={16} />
          </a>
        )
      }
    </div>
  </main>
</BaseLayout>
