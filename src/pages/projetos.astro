---
import Icon from '../components/Icon.astro'
import ProjectCard from '../components/ProjectCard.astro'
import PageCover from '../components/PageCover.astro'
import { projects as allProjects } from '../content'
import { repositoryUrl } from '../content/catalog'
import { byLanguage, languageAnchor as anchor, REPOSITORY } from '../content/projects'
import { MAIN_ID, TEXT } from '../content/site'
import { breadcrumbs, collection, sourceCode } from '../content/structured-data'
import BaseLayout from '../layouts/BaseLayout.astro'

const projects = await allProjects()
const groups = byLanguage(projects.map((project) => project.data))
const labels = TEXT.projects
const origin = Astro.site ?? Astro.url.origin
---

<BaseLayout
  title={labels.headline}
  description={labels.lede}
  path="/projetos/"
  structuredData={{
    '@graph': [
      breadcrumbs(origin, [{ name: labels.title, path: '/projetos/' }]),
      collection(
        origin,
        { path: '/projetos/', name: labels.headline, description: labels.lede },
        projects.map((project) => ({
          name: project.data.name,
          url: project.data.url,
          item: sourceCode({
            name: project.data.name,
            url: project.data.url,
            language: project.data.language,
            ...(/^https?:\/\/(www\.)?github\.com\//.test(project.data.url) ? { owner: project.data.source.split('/')[0] } : {}),
          }),
        })),
      ),
    ],
  }}
>
  <main id={MAIN_ID}>
    <PageCover title={labels.title} lede={labels.lede}>
      <ul class="bb-facts">
        <li>{labels.count(projects.length)}</li>
      </ul>
      <div class="bb-actions">
        <a href={labels.addUrl} target="_blank" rel="noopener noreferrer" class="bb-button bb-button--primary">
          {labels.add}
          <Icon name="external" size={16} />
        </a>
        <a href={repositoryUrl(REPOSITORY)} target="_blank" rel="noopener noreferrer" class="bb-button bb-button--ghost">
          {labels.list}
          <Icon name="external" size={16} />
        </a>
      </div>
    </PageCover>
    <div class="bb-wrap bb-main">
      <div class="bb-filter" role="group" aria-label={labels.languages}>
        <button type="button" data-filter="" aria-pressed="true">
          {labels.all}
          <span>{projects.length}</span>
        </button>
        {
          [...groups]
            .sort((a, b) => b.projects.length - a.projects.length)
            .map((group) => (
              <button type="button" data-filter={anchor(group.language)} aria-pressed="false">
                {group.language}
                <span>{group.projects.length}</span>
              </button>
            ))
        }
      </div>
      <ul class="bb-cards" data-project-list>
        {projects.map((project) => <ProjectCard project={project.data} level="h2" />)}
      </ul>
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/project-filter.ts'
</script>
