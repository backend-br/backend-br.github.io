---
import type { SolutionCard } from '../content/challenges'
import { avatarOf } from '../content/catalog'
import { TEXT } from '../content/site'
import EntryCard from './EntryCard.astro'

interface Props {
  solution: SolutionCard
}

const { solution } = Astro.props
const labels = TEXT.challenges
---

<EntryCard
  avatar={avatarOf(solution.owner)}
  source={solution.owner}
  {...(solution.first ? { meta: labels.first } : {})}
  title={solution.name}
  href={solution.repository}
  stack={[solution.language]}
  kind={labels.solutionKind}
  kindIcon="code"
  links={[{ url: solution.repository, label: labels.solutionOf(solution.owner), icon: 'github' }]}
  highlight={solution.first}
/>
