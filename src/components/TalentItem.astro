---
import type { TalentEntry } from '../content'
import { TEXT } from '../content/site'
import { anchor } from '../content/talents'
import EntryCard from './EntryCard.astro'
import type { IconName } from './icons'

interface Props {
  talent: TalentEntry
}

const { data } = Astro.props.talent
const labels = TEXT.talents
const channels: readonly { url: string | null; label: string; icon: IconName }[] = [
  { url: data.linkedin, label: labels.linkedin, icon: 'linkedin' },
  { url: data.github, label: labels.github, icon: 'github' },
  { url: data.portfolio, label: labels.portfolio, icon: 'globe' },
  { url: data.url, label: labels.profile, icon: 'external' },
]
const links = channels.flatMap(({ url, label, icon }) =>
  url === null ? [] : [{ url, label: labels.contactOf(data.name, label), icon }],
)
---

<EntryCard
  id={anchor(data.number)}
  avatar={data.avatar}
  source={data.login || data.name}
  instant={{ value: data.updated, label: labels.updated }}
  title={data.name}
  subtitle={data.role}
  summary={data.about}
  stack={[...data.stack, ...data.level, ...data.contract, ...data.modality]}
  kind={labels.kind}
  kindIcon="users"
  links={links}
/>
