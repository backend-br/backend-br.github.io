---
import { TEXT } from '../content/site'
import Icon from './Icon.astro'
import type { IconName } from './icons'

interface Props {
  title: string
  lede: string
  trail?: readonly { readonly label: string; readonly href: string }[]
  compact?: boolean
  icon?: IconName
}
const { title, lede, trail = [], compact = false, icon } = Astro.props
---

<div class="bb-cover">
  <div class="bb-wrap bb-cover__inner">
    {
      trail.length > 0 && (
        <nav aria-label={TEXT.nav.crumbs} class="bb-crumbs" data-pagefind-ignore>
          {trail.map((step, index) => (
            <>
              {index > 0 && <span aria-hidden="true">/</span>}
              <a href={step.href}>{step.label}</a>
            </>
          ))}
        </nav>
      )
    }
    <h1 class:list={['bb-display bb-cover__title', { 'bb-cover__title--compact': compact }]}>
      {
        icon && (
          <span class="bb-cover__icon">
            <Icon name={icon} size={28} />
          </span>
        )
      }
      {title}
    </h1>
    <p class="bb-cover__lede">{lede}</p>
    <slot />
  </div>
</div>
