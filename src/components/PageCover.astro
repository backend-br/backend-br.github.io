---
/**
 * The cover of an inner page: where it sits, its title and what it holds. The slot under the lede takes
 * what the page adds, such as its figures and its actions.
 */
import { TEXT } from '../content/site'

interface Props {
  title: string
  lede: string
  /** The pages between the home and this one, each a link. */
  trail?: readonly { readonly label: string; readonly href: string }[]
  /** Sets a long title, such as the one of an opening, smaller than the name of a section. */
  compact?: boolean
}
const { title, lede, trail = [], compact = false } = Astro.props
---

<div class="bb-cover">
  <div class="bb-wrap bb-cover__inner">
    <nav aria-label={TEXT.nav.crumbs} class="bb-crumbs" data-pagefind-ignore>
      <a href="/">{TEXT.nav.home}</a>
      {
        trail.map((step) => (
          <>
            <span aria-hidden="true">/</span>
            <a href={step.href}>{step.label}</a>
          </>
        ))
      }
    </nav>
    <h1 class:list={['bb-display bb-cover__title', { 'bb-cover__title--compact': compact }]}>{title}</h1>
    <p class="bb-cover__lede">{lede}</p>
    <slot />
  </div>
</div>
