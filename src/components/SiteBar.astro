---
import { SITE, TEXT } from '../content/site'
import BrandMark from './BrandMark.astro'
import Icon from './Icon.astro'
import SearchForm from './SearchForm.astro'
import { HOME, isCurrent, SECTIONS } from './sections'
import ThemeToggle from './ThemeToggle.astro'

const here = Astro.url.pathname
const current = (section: (typeof SECTIONS)[number]): 'page' | undefined =>
  isCurrent(section, here) ? 'page' : undefined
---

<header class="bb-bar">
  <div class="bb-wrap bb-bar__inner">
    <a href="/" class="bb-home" aria-label={TEXT.nav.homeLink}>
      <BrandMark />
    </a>
    <nav class="bb-nav" aria-label={TEXT.nav.label}>
      <ul>
        {
          SECTIONS.map((section) => (
            <li>
              <a href={section.path} aria-current={current(section)}>
                <Icon name={section.icon} size={18} />
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="bb-tools">
      <a
        href="/busca/"
        class="bb-tool bb-tool--search"
        aria-label={TEXT.nav.search}
        title={TEXT.nav.search}
        aria-haspopup="dialog"
        data-search-open
      >
        <Icon name="search" size={18} />
        <span aria-hidden="true">{TEXT.nav.searchShort}</span>
        <kbd aria-hidden="true">{TEXT.search.shortcut}</kbd>
      </a>
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="bb-tool"
        aria-label={TEXT.nav.github}
        title={TEXT.nav.github}
      >
        <Icon name="github" size={18} />
      </a>
      <ThemeToggle theme={TEXT.theme} />
    </div>
  </div>
</header>

<nav class="bb-tabbar" aria-label={TEXT.nav.label}>
  <ul>
    {
      [HOME, ...SECTIONS].map((section) => (
        <li>
          <a href={section.path} aria-current={current(section)}>
            <Icon name={section.icon} size={20} />
            <span>{section.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<dialog class="bb-dialog" aria-label={TEXT.search.title} closedby="any" data-search-dialog>
  <div class="bb-dialog__head">
    <p class="bb-dialog__title">{TEXT.search.title}</p>
    <form method="dialog">
      <button type="submit" class="bb-tool" aria-label={TEXT.search.close} title={TEXT.search.close}>
        <span aria-hidden="true">✕</span>
      </button>
    </form>
  </div>
  <SearchForm id="search-dialog-term" autofocus />
</dialog>
