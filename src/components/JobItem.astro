---
import type { JobEntry } from '../content'
import { jobSummary } from '../content/posting'
import { TEXT } from '../content/site'
import EntryCard from './EntryCard.astro'

interface Props {
  job: JobEntry
}

const { data, body } = Astro.props.job
const labels = TEXT.jobs
---

<EntryCard
  avatar={data.avatar}
  source={data.author || labels.deleted}
  instant={{ value: data.opened, label: labels.opened }}
  title={data.title}
  href={`/vagas/${data.number}/`}
  summary={jobSummary(body ?? '')}
  terms={[...data.modality, ...data.level, ...data.contract]}
  stack={data.stack}
  kind={data.open ? labels.kind : labels.closedKind}
  kindIcon="briefcase"
  links={[{ url: data.url, label: labels.apply, icon: 'external' }]}
  muted={!data.open}
/>
