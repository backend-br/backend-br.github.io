---
import type { ProjectEntry } from '../content'
import { avatarOf } from '../content/catalog'
import { languageAnchor } from '../content/projects'
import { TEXT } from '../content/site'
import EntryCard from './EntryCard.astro'

interface Props {
  project: ProjectEntry['data']
  level?: 'h2' | 'h3'
}

const { project, level = 'h3' } = Astro.props
const owner = project.source.split('/')[0] ?? ''
const labels = TEXT.projects
---

<EntryCard
  data-language={languageAnchor(project.language)}
  avatar={avatarOf(owner)}
  source={owner}
  stars={project.stars}
  title={project.name}
  href={project.url}
  level={level}
  stack={project.language ? [project.language] : []}
  kind={labels.kind}
  kindIcon="star"
  links={[{ url: project.url, label: TEXT.onGitHub(project.name), icon: 'github' }]}
/>
