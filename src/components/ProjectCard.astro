---
/**
 * One open-source project: who owns it on GitHub, its name linking to the source code, its other links,
 * such as documentation or a site, and its language. The language is also on the card as data, which the
 * filter of the page reads.
 */
import { avatarOf } from '../content/catalog'
import type { Project } from '../content/projects'
import { languageAnchor } from '../content/projects'
import { TEXT } from '../content/site'
import Avatar from './Avatar.astro'

interface Props {
  project: Project
  /** The level of the name, which follows the heading of the list it sits in. */
  level?: 'h2' | 'h3'
}
const { project, level: Heading = 'h3' } = Astro.props
const owner = /^https?:\/\/(www\.)?github\.com\//.test(project.url) ? (project.source.split('/')[0] ?? '') : ''
---

<li class="bb-card" data-language={languageAnchor(project.language)}>
  <div class="bb-card__head">
    <Avatar url={owner ? avatarOf(owner) : ''} size={28} />
    <p class="bb-card__who">
      <span class="bb-card__author">{owner || project.source}</span>
    </p>
  </div>
  <Heading class="bb-card__title">
    <a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a>
  </Heading>
  {
    project.links.length > 0 && (
      <ul class="bb-card__links">
        {project.links.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={TEXT.projects.linkOf(link.label, project.name)}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  {
    project.language && (
      <ul class="bb-chips bb-card__tags">
        <li class="bb-chip">{project.language}</li>
      </ul>
    )
  }
</li>
