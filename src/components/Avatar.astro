---
/**
 * The avatar of who posted an opening, as GitHub serves it at the size it is drawn, twice over for dense
 * screens. An account GitHub deleted has no avatar, and its place is kept by a plain circle.
 */
interface Props {
  url: string
  /** The size the avatar is drawn at, in CSS pixels. */
  size: number
}
const { url, size } = Astro.props

/** Answers the address of the avatar at a size, which GitHub reads from the `s` parameter. */
function sized(address: string, pixels: number): string {
  const sized = new URL(address)
  sized.searchParams.set('s', String(pixels))
  return sized.href
}
---

{
  url ? (
    <img class="bb-avatar" src={sized(url, size * 2)} width={size} height={size} alt="" loading="lazy" decoding="async" />
  ) : (
    <span class="bb-avatar" style={`width:${size}px;height:${size}px`} aria-hidden="true" />
  )
}
