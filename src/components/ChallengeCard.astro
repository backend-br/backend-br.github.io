---
import type { Challenge } from '../content'
import { avatarOf, blobUrl } from '../content/catalog'
import { REPOSITORY } from '../content/challenges'
import { TEXT } from '../content/site'
import EntryCard from './EntryCard.astro'

interface Props {
  challenge: Challenge
  level?: 'h2' | 'h3'
}

const { challenge, level = 'h3' } = Astro.props
const { data } = challenge
const labels = TEXT.challenges
const first = data.solutions.find((solution) => solution.first)
---

<EntryCard
  avatar={first ? avatarOf(first.owner) : ''}
  {...(first ? { mark: '🥇' } : {})}
  source={first ? first.owner : labels.noFirst}
  meta={labels.solutions(data.solutionCount)}
  title={data.title}
  href={`/desafios/${data.slug}/`}
  level={level}
  summary={data.summary}
  stack={data.languages.map((group) => group.language)}
  links={[{ url: blobUrl(REPOSITORY, `${data.slug}/PROBLEM.md`), label: labels.statement, icon: 'external' }]}
/>
